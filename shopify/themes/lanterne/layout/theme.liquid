<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    {%- for scheme in settings.color_schemes limit: 1 -%}
      <meta name="theme-color" content="{{ scheme.settings.background }}">
    {%- endfor -%}

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- unless settings.type_heading_font.system? and settings.type_body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}

    {% render 'meta-tags' %}
    {% render 'css-variables' %}

    {{ 'base.css' | asset_url | stylesheet_tag }}

    <script>
      document.documentElement.classList.replace('no-js', 'js');
    </script>
    <script src="{{ 'theme.js' | asset_url }}" type="module" defer="defer"></script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ request.page_type | handle }} color-scheme-1">
    <a class="skip-link button" href="#MainContent">{{ 'accessibility.skip_to_text' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main-content" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    <div class="visually-hidden" role="status" aria-live="polite" data-live-region></div>

    <script>
      window.theme = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          cartUpdate: {{ routes.cart_update_url | json }},
          predictiveSearch: {{ routes.predictive_search_url | json }},
          productRecommendations: {{ routes.product_recommendations_url | json }}
        },
        strings: {
          cartError: {{ 'cart.error' | t | json }},
          loading: {{ 'accessibility.loading' | t | json }},
          cartUpdated: {{ 'cart.updated' | t | json }},
          resultsCount: {{ 'search.results_announcement' | t | json }}
        }
      };
    </script>
  </body>
</html>
