{%- doc -%}
  Lets customers send a gift card to a recipient on a chosen date.
  Must be rendered inside the product form.

  @param {object} form - The product form object
  @param {string} section_id - The section ID
{%- enddoc -%}
<div class="recipient-form" data-recipient-form>
  <div class="checkbox-field">
    <input
      type="checkbox"
      class="checkbox-field__input"
      id="Recipient-checkbox-{{ section_id }}"
      name="properties[__shopify_send_gift_card_to_recipient]"
      value="on"
      {% if form.email != blank %}
        checked
      {% endif %}
      data-recipient-toggle
    >
    <label for="Recipient-checkbox-{{ section_id }}">{{ 'gift_cards.recipient.checkbox' | t }}</label>
  </div>

  <div class="recipient-form__fields" data-recipient-fields>
    {%- if form.errors -%}
      <div class="form-message form-message--error" role="alert">
        <p>{{ 'gift_cards.recipient.error_message' | t }}</p>
        <ul>
          {%- for field in form.errors -%}
            <li>{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    <div class="field">
      <label class="field__label" for="Recipient-email-{{ section_id }}">{{ 'gift_cards.recipient.email_label' | t }}</label>
      <input
        id="Recipient-email-{{ section_id }}"
        class="field__input"
        type="email"
        name="properties[Recipient email]"
        value="{{ form.email }}"
        autocomplete="email"
        {% if form.errors contains 'email' %}
          aria-invalid="true"
        {% endif %}
      >
    </div>

    <div class="field">
      <label class="field__label" for="Recipient-name-{{ section_id }}">{{ 'gift_cards.recipient.name_label' | t }}</label>
      <input
        id="Recipient-name-{{ section_id }}"
        class="field__input"
        type="text"
        name="properties[Recipient name]"
        value="{{ form.name }}"
        autocomplete="name"
      >
    </div>

    <div class="field">
      <label class="field__label" for="Recipient-message-{{ section_id }}">{{ 'gift_cards.recipient.message_label' | t }}</label>
      <textarea
        id="Recipient-message-{{ section_id }}"
        class="field__input"
        name="properties[Message]"
        rows="4"
        maxlength="200"
        aria-describedby="Recipient-message-hint-{{ section_id }}"
      >{{ form.message }}</textarea>
      <p class="field__hint" id="Recipient-message-hint-{{ section_id }}">{{ 'gift_cards.recipient.max_characters' | t: max_characters: 200 }}</p>
    </div>

    <div class="field">
      <label class="field__label" for="Recipient-send-on-{{ section_id }}">{{ 'gift_cards.recipient.send_on_label' | t }}</label>
      <input
        id="Recipient-send-on-{{ section_id }}"
        class="field__input"
        type="date"
        name="properties[Send on]"
        value="{{ form.send_on }}"
        pattern="\d{4}-\d{2}-\d{2}"
        aria-describedby="Recipient-send-on-hint-{{ section_id }}"
      >
      <p class="field__hint" id="Recipient-send-on-hint-{{ section_id }}">{{ 'gift_cards.recipient.send_on_hint' | t }}</p>
    </div>
    <input type="hidden" name="properties[__shopify_offset]" value="" data-timezone-offset>
  </div>
</div>
