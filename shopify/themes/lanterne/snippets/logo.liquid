{%- doc -%}
  Renders the uploaded store logo, or the store name when no logo is set.

  @param {boolean} [eager] - Load the logo eagerly (header)
  @param {string} [class] - Extra classes
{%- enddoc -%}
{%- liquid
  if eager
    assign loading = 'eager'
  else
    assign loading = 'lazy'
  endif
  assign logo_width = settings.logo_width
  assign logo_sizes = settings.logo_width | append: 'px'
-%}
{%- if settings.logo != blank -%}
  {%- assign uploaded_height = logo_width | divided_by: settings.logo.aspect_ratio | round -%}
  {{
    settings.logo
    | image_url: width: 600
    | image_tag:
      widths: '160, 240, 320, 480, 600',
      sizes: logo_sizes,
      width: logo_width,
      height: uploaded_height,
      loading: loading,
      alt: shop.name,
      class: 'logo__image'
  }}
{%- else -%}
  <span class="logo__text {{ class }}">{{ shop.name | escape }}</span>
{%- endif -%}
