<div class="contact-form section color-{{ section.settings.color_scheme }} section--padding-medium">
  <div class="page-width page-width--narrow">
    {%- if section.settings.heading != blank -%}
      <h2 class="h2">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- assign form_id = 'ContactForm-' | append: section.id -%}
    {%- form 'contact', id: form_id, class: 'contact' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success" role="status" tabindex="-1" autofocus>
          {% render 'icon', name: 'check' %}
          {{ 'contact.success' | t }}
        </p>
      {%- elsif form.errors -%}
        <div class="form-message form-message--error" role="alert" tabindex="-1" autofocus>
          <p>{{ 'contact.error_heading' | t }}</p>
          <ul>
            {%- for field in form.errors -%}
              <li>
                {%- if field == 'form' -%}
                  {{ form.errors.messages[field] }}
                {%- else -%}
                  <a href="#ContactForm-{{ field }}-{{ section.id }}" class="link">{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <div class="contact__grid">
        <div class="field">
          <label class="field__label" for="ContactForm-name-{{ section.id }}">{{ 'contact.name' | t }}</label>
          <input class="field__input" type="text" id="ContactForm-name-{{ section.id }}" name="contact[{{ 'contact.name' | t }}]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" autocomplete="name">
        </div>
        <div class="field">
          <label class="field__label" for="ContactForm-email-{{ section.id }}">{{ 'contact.email' | t }} <span aria-hidden="true">*</span></label>
          <input
            class="field__input"
            type="email"
            id="ContactForm-email-{{ section.id }}"
            name="contact[email]"
            value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            autocomplete="email"
            autocapitalize="off"
            spellcheck="false"
            required
            aria-required="true"
            {% if form.errors contains 'email' %}
              aria-invalid="true"
            {% endif %}
          >
        </div>
      </div>
      <div class="field">
        <label class="field__label" for="ContactForm-phone-{{ section.id }}">{{ 'contact.phone' | t }}</label>
        <input class="field__input" type="tel" id="ContactForm-phone-{{ section.id }}" name="contact[{{ 'contact.phone' | t }}]" value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}" autocomplete="tel" pattern="[0-9\-\+\s\(\)]*">
      </div>
      <div class="field">
        <label class="field__label" for="ContactForm-body-{{ section.id }}">{{ 'contact.message' | t }}</label>
        <textarea class="field__input" rows="8" id="ContactForm-body-{{ section.id }}" name="contact[{{ 'contact.message' | t }}]">{{ form.body }}</textarea>
      </div>
      <button type="submit" class="button">{{ 'contact.send' | t }}</button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "t:names.contact_form",
  "class": "section-contact-form",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Contact form"
    }
  ],
  "presets": [
    {
      "name": "t:names.contact_form"
    }
  ]
}
{% endschema %}
