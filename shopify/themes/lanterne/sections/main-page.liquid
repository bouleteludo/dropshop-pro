<div class="main-page section color-{{ section.settings.color_scheme }} section--padding-medium">
  <div class="page-width page-width--narrow">
    <h1 class="h1 page-title">{{ page.title | escape }}</h1>
    <div class="rte">{{ page.content }}</div>
  </div>
</div>

{% schema %}
{
  "name": "t:names.page",
  "class": "section-main-page",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
