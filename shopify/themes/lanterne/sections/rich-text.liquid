<div class="rich-text section color-{{ section.settings.color_scheme }} section--padding-{{ section.settings.padding }}">
  <div class="page-width page-width--narrow rich-text__inner rich-text__inner--{{ section.settings.alignment }}">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'heading' -%}
          <h2 class="{{ block.settings.size }}" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
        {%- when 'text' -%}
          <div class="rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
        {%- when 'button' -%}
          {%- if block.settings.label != blank -%}
            <a
              {% if block.settings.link != blank %}
                href="{{ block.settings.link }}"
              {% else %}
                role="link" aria-disabled="true"
              {% endif %}
              class="button{% if block.settings.secondary %} button--secondary{% endif %}"
              {{ block.shopify_attributes }}
            >
              {{- block.settings.label | escape -}}
            </a>
          {%- endif -%}
      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "t:names.rich_text",
  "class": "section-rich-text",
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:settings.alignment",
      "options": [
        { "value": "left", "label": "t:options.left" },
        { "value": "center", "label": "t:options.center" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "padding",
      "label": "t:settings.padding",
      "options": [
        { "value": "small", "label": "t:options.small" },
        { "value": "medium", "label": "t:options.medium" },
        { "value": "large", "label": "t:options.large" }
      ],
      "default": "medium"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "t:names.heading",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "t:settings.heading",
          "default": "Talk about your brand"
        },
        {
          "type": "select",
          "id": "size",
          "label": "t:settings.heading_size",
          "options": [
            { "value": "h3", "label": "t:options.small" },
            { "value": "h2", "label": "t:options.medium" },
            { "value": "h1", "label": "t:options.large" }
          ],
          "default": "h2"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:names.text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "t:settings.text",
          "default": "<p>Share information about your brand with your customers. Describe a product, make announcements or welcome customers to your store.</p>"
        }
      ]
    },
    {
      "type": "button",
      "name": "t:names.button",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:settings.button_label",
          "default": "Button label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:settings.button_link"
        },
        {
          "type": "checkbox",
          "id": "secondary",
          "label": "t:settings.secondary_button",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.rich_text",
      "blocks": [
        { "type": "heading" },
        { "type": "text" },
        { "type": "button" }
      ]
    }
  ]
}
{% endschema %}
