{%- doc -%}
  Renders one block of the product information column. Shared by the main
  product section and the featured product section.

  @param {object} block - The section block
  @param {product} product - The product
  @param {variant} selected_variant - The selected variant
  @param {string} section_id - The section ID
  @param {string} form_id - The ID of the product form
  @param {string} [heading_tag] - Element used for the product title
{%- enddoc -%}
{%- assign heading_tag = heading_tag | default: 'h2' -%}
{%- case block.type -%}
  {%- when '@app' -%}
    <div class="product-info__block product-info__block--app">{% render block %}</div>

  {%- when 'text' -%}
    <div class="product-info__block product-info__text{% if block.settings.style == 'eyebrow' %} eyebrow{% else %} rte{% endif %}" {{ block.shopify_attributes }}>
      {{- block.settings.text -}}
    </div>

  {%- when 'title' -%}
    <{{ heading_tag }} class="h1 product-info__title" {{ block.shopify_attributes }}>
      {{- product.title | escape -}}
    </{{ heading_tag }}>

  {%- when 'vendor' -%}
    {%- if product.vendor != blank -%}
      <p class="product-info__vendor" {{ block.shopify_attributes }}>
        <span class="visually-hidden">{{ 'products.vendor' | t }}</span>
        {{ product.vendor | link_to_vendor }}
      </p>
    {%- endif -%}

  {%- when 'price' -%}
    <div class="product-info__block" {{ block.shopify_attributes }}>
      <div data-product-part="price-{{ section_id }}">
        {% render 'price', product: product, variant: selected_variant, class: 'price--large' %}
        {%- if cart.taxes_included or shop.shipping_policy.body != blank -%}
          <p class="product-info__tax">
            {%- if cart.taxes_included -%}
              {{ 'products.tax_included' | t }}
            {%- endif -%}
            {%- if shop.shipping_policy.body != blank -%}
              {{ 'products.shipping_policy_html' | t: link: shop.shipping_policy.url }}
            {%- endif -%}
          </p>
        {%- endif -%}
      </div>
      <div data-product-part="installments-{{ section_id }}">
        {%- assign installment_form_id = 'ProductInstallments-' | append: section_id -%}
        {%- form 'product', product, id: installment_form_id, class: 'product-info__installments' -%}
          <input type="hidden" name="id" value="{{ selected_variant.id }}">
          {{ form | payment_terms }}
        {%- endform -%}
      </div>
    </div>

  {%- when 'variant_picker' -%}
    {%- unless product.has_only_default_variant -%}
      <div class="product-info__block variant-picker" data-product-part="picker-{{ section_id }}" {{ block.shopify_attributes }}>
        {%- for option in product.options_with_values -%}
          {%- assign option_index = forloop.index -%}
          {%- liquid
            assign has_swatches = false
            if block.settings.show_swatches and option.values.first.swatch
              assign has_swatches = true
            endif
          -%}
          {%- if block.settings.picker_type == 'dropdown' and has_swatches == false -%}
            <div class="field variant-picker__option">
              <label class="field__label" for="Option-{{ section_id }}-{{ option_index }}">{{ option.name | escape }}</label>
              <select id="Option-{{ section_id }}-{{ option_index }}" class="field__input field__select" data-option-select>
                {%- for value in option.values -%}
                  <option
                    value="{{ value.id }}"
                    data-option-value-id="{{ value.id }}"
                    {% if value.selected %}
                      selected="selected"
                    {% endif %}
                  >
                    {{ value.name | escape }}
                    {%- unless value.available %} &ndash; {{ 'products.variant.unavailable' | t }}{% endunless -%}
                  </option>
                {%- endfor -%}
              </select>
            </div>
          {%- else -%}
            <fieldset class="variant-picker__option">
              <legend class="field__label">
                {{ option.name | escape }} <span class="variant-picker__selected">&ndash; {{ option.selected_value | escape }}</span>
              </legend>
              <div class="variant-picker__values">
                {%- for value in option.values -%}
                  {%- assign input_id = 'Option-' | append: section_id | append: '-' | append: option_index | append: '-' | append: forloop.index -%}
                  <input
                    type="radio"
                    class="variant-picker__input visually-hidden"
                    id="{{ input_id }}"
                    name="option-{{ section_id }}-{{ option_index }}"
                    value="{{ value.id }}"
                    data-option-value-id="{{ value.id }}"
                    {% if value.selected %}
                      checked
                    {% endif %}
                  >
                  <label
                    for="{{ input_id }}"
                    class="variant-picker__value{% if has_swatches %} variant-picker__value--swatch{% endif %}{% unless value.available %} is-unavailable{% endunless %}"
                  >
                    {%- if has_swatches -%}
                      {%- if value.swatch.image -%}
                        <span class="swatch" style="--swatch-image: url({{ value.swatch.image | image_url: width: 80 }});" aria-hidden="true"></span>
                      {%- else -%}
                        <span class="swatch" style="--swatch-color: {{ value.swatch.color }};" aria-hidden="true"></span>
                      {%- endif -%}
                      <span class="visually-hidden">{{ value.name | escape }}</span>
                    {%- else -%}
                      {{ value.name | escape }}
                    {%- endif -%}
                    {%- unless value.available -%}
                      <span class="visually-hidden">{{ 'products.variant.unavailable' | t }}</span>
                    {%- endunless -%}
                  </label>
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endunless -%}

  {%- when 'quantity_selector' -%}
    {%- liquid
      assign rule = selected_variant.quantity_rule
      assign qty_min = rule.min | default: 1
      assign qty_step = rule.increment | default: 1
    -%}
    <div class="product-info__block field" {{ block.shopify_attributes }}>
      <label class="field__label" for="Quantity-{{ section_id }}">{{ 'products.quantity.label' | t }}</label>
      <quantity-input class="quantity">
        <button type="button" class="quantity__button" name="minus">
          {% render 'icon', name: 'minus' %}
          <span class="visually-hidden">{{ 'products.quantity.decrease' | t: product: product.title }}</span>
        </button>
        <input
          class="quantity__input"
          id="Quantity-{{ section_id }}"
          type="number"
          name="quantity"
          value="{{ qty_min }}"
          min="{{ qty_min }}"
          step="{{ qty_step }}"
          {% if rule.max != null %}
            max="{{ rule.max }}"
          {% endif %}
          inputmode="numeric"
          form="{{ form_id }}"
        >
        <button type="button" class="quantity__button" name="plus">
          {% render 'icon', name: 'plus' %}
          <span class="visually-hidden">{{ 'products.quantity.increase' | t: product: product.title }}</span>
        </button>
      </quantity-input>
      {%- if rule.min > 1 or rule.increment > 1 or rule.max != null -%}
        <p class="field__hint">
          {%- if rule.increment > 1 -%}{{ 'products.quantity.multiples_of' | t: quantity: rule.increment }} {% endif -%}
          {%- if rule.min > 1 -%}{{ 'products.quantity.min' | t: quantity: rule.min }} {% endif -%}
          {%- if rule.max != null -%}{{ 'products.quantity.max' | t: quantity: rule.max }}{%- endif -%}
        </p>
      {%- endif -%}
    </div>

  {%- when 'buy_buttons' -%}
    <div class="product-info__block product-form" {{ block.shopify_attributes }}>
      {%- form 'product', product, id: form_id, class: 'product-form__form', novalidate: 'novalidate' -%}
        <input type="hidden" name="id" value="{{ selected_variant.id }}" data-variant-id>

        {%- if product.selling_plan_groups.size > 0 -%}
          <fieldset class="selling-plans">
            <legend class="field__label">{{ 'products.selling_plans.label' | t }}</legend>
            {%- unless product.requires_selling_plan -%}
              <div class="selling-plans__option">
                <input type="radio" id="SellingPlan-{{ section_id }}-none" name="selling_plan" value="" checked>
                <label for="SellingPlan-{{ section_id }}-none">{{ 'products.selling_plans.one_time' | t }}</label>
              </div>
            {%- endunless -%}
            {%- for group in product.selling_plan_groups -%}
              {%- for plan in group.selling_plans -%}
                <div class="selling-plans__option">
                  <input
                    type="radio"
                    id="SellingPlan-{{ section_id }}-{{ plan.id }}"
                    name="selling_plan"
                    value="{{ plan.id }}"
                    {% if product.requires_selling_plan and forloop.parentloop.first and forloop.first %}
                      checked
                    {% endif %}
                  >
                  <label for="SellingPlan-{{ section_id }}-{{ plan.id }}">
                    {{ group.name | escape }} &ndash; {{ plan.name | escape }}
                  </label>
                </div>
              {%- endfor -%}
            {%- endfor -%}
          </fieldset>
        {%- endif -%}

        {%- if product.gift_card? and block.settings.show_gift_card_recipient -%}
          {% render 'gift-card-recipient-form', form: form, section_id: section_id %}
        {%- endif -%}

        <div class="product-form__buttons">
          <div data-product-part="add-button-{{ section_id }}">
            <button
              type="submit"
              name="add"
              class="button button--full"
              {% unless selected_variant.available %}
                disabled
              {% endunless %}
            >
              {%- if selected_variant == nil -%}
                {{ 'products.variant.unavailable' | t }}
              {%- elsif selected_variant.available -%}
                {{ 'products.add_to_cart' | t }}
              {%- else -%}
                {{ 'products.sold_out' | t }}
              {%- endif -%}
            </button>
          </div>
          {%- if block.settings.show_dynamic_checkout -%}
            {{ form | payment_button }}
          {%- endif -%}
        </div>
      {%- endform -%}

      <div data-product-part="pickup-{{ section_id }}">
        {%- assign pickup_locations = selected_variant.store_availabilities | where: 'pick_up_enabled', true -%}
        {%- if pickup_locations.size > 0 -%}
          {%- assign closest = pickup_locations.first -%}
          <div class="pickup">
            {% render 'icon', name: 'pin' %}
            <div>
              {%- if closest.available -%}
                <p class="pickup__status">{{ 'products.pickup.available_at_html' | t: location: closest.location.name }}</p>
                <p class="pickup__time">{{ closest.pick_up_time }}</p>
              {%- else -%}
                <p class="pickup__status">{{ 'products.pickup.unavailable_at_html' | t: location: closest.location.name }}</p>
              {%- endif -%}
              <details class="pickup__details">
                <summary class="link">{{ 'products.pickup.view_stores' | t }}</summary>
                <ul class="pickup__list" role="list">
                  {%- for availability in pickup_locations -%}
                    <li>
                      <p class="pickup__location">{{ availability.location.name | escape }}</p>
                      <p>
                        {%- if availability.available -%}
                          {{ 'products.pickup.available' | t }} &middot; {{ availability.pick_up_time }}
                        {%- else -%}
                          {{ 'products.pickup.unavailable' | t }}
                        {%- endif -%}
                      </p>
                      <address class="pickup__address">{{ availability.location.address | format_address }}</address>
                      {%- if availability.location.address.phone.size > 0 -%}
                        <p>{{ availability.location.address.phone }}</p>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
              </details>
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>

  {%- when 'delivery_deadline' -%}
    {%- capture deadline -%}{% render 'delivery-deadline' %}{%- endcapture -%}
    {%- if deadline != blank -%}
      <div class="product-info__block" {{ block.shopify_attributes }}>{{ deadline }}</div>
    {%- endif -%}

  {%- when 'description' -%}
    {%- if product.description != blank -%}
      <div class="product-info__block rte product-info__description" {{ block.shopify_attributes }}>
        {{ product.description }}
      </div>
    {%- endif -%}

  {%- when 'collapsible_tab' -%}
    <details class="product-info__block accordion" {{ block.shopify_attributes }}>
      <summary class="accordion__summary">
        {%- if block.settings.icon != 'none' -%}
          {% render 'icon', name: block.settings.icon %}
        {%- endif -%}
        <span class="accordion__title">{{ block.settings.heading | default: block.settings.page.title | escape }}</span>
        {% render 'icon', name: 'chevron-down', class: 'accordion__chevron' %}
      </summary>
      <div class="accordion__content rte">
        {{ block.settings.content }}
        {{ block.settings.page.content }}
      </div>
    </details>

  {%- when 'complementary' -%}
    <product-recommendations
      class="product-info__block complementary"
      data-url="{{ routes.product_recommendations_url }}?product_id={{ product.id }}&limit={{ block.settings.product_count }}&intent=complementary&section_id={{ section_id }}"
      data-target="complementary-{{ block.id }}"
      {{ block.shopify_attributes }}
    >
      <div data-recommendations-target="complementary-{{ block.id }}"></div>
    </product-recommendations>

  {%- when 'custom_liquid' -%}
    <div class="product-info__block" {{ block.shopify_attributes }}>
      {{ block.settings.custom_liquid }}
    </div>
{%- endcase -%}
