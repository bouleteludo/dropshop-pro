<div class="custom-liquid section color-{{ section.settings.color_scheme }} section--padding-{{ section.settings.padding }}">
  <div class="page-width">
    {{ section.settings.custom_liquid }}
  </div>
</div>

{% schema %}
{
  "name": "t:names.custom_liquid",
  "class": "section-custom-liquid",
  "settings": [
    {
      "type": "liquid",
      "id": "custom_liquid",
      "label": "t:settings.custom_liquid",
      "info": "t:info.custom_liquid"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "padding",
      "label": "t:settings.padding",
      "options": [
        { "value": "none", "label": "t:options.none" },
        { "value": "small", "label": "t:options.small" },
        { "value": "medium", "label": "t:options.medium" },
        { "value": "large", "label": "t:options.large" }
      ],
      "default": "medium"
    }
  ],
  "presets": [
    {
      "name": "t:names.custom_liquid"
    }
  ]
}
{% endschema %}
