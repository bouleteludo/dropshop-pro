{%- liquid
  assign artwork = section.settings.artwork
  assign heading_tag = section.settings.heading_tag
  if section.index == 1
    assign loading = 'eager'
    assign priority = 'high'
  else
    assign loading = 'lazy'
    assign priority = 'auto'
  endif
-%}

<div
  class="seasonal-hero color-{{ section.settings.color_scheme }} seasonal-hero--{{ section.settings.height }} seasonal-hero--content-{{ section.settings.content_position }}"
  style="--overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}; --image-position: {{ section.settings.image_position }}; --image-position-mobile: {{ section.settings.mobile_image_position }};"
>
  <div class="seasonal-hero__media{% if section.settings.animate_image %} seasonal-hero__media--animated{% endif %}">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 3000
        | image_tag:
          widths: '640, 960, 1280, 1600, 2000, 2400, 3000',
          sizes: '100vw',
          loading: loading,
          fetchpriority: priority,
          alt: section.settings.image.alt,
          class: 'seasonal-hero__image'
      }}
    {%- elsif artwork != 'none' -%}
      {%- liquid
        assign art_base = 'hero-' | append: artwork
        assign art_640 = art_base | append: '-640.webp' | asset_url
        assign art_1024 = art_base | append: '-1024.webp' | asset_url
        assign art_1440 = art_base | append: '-1440.webp' | asset_url
        assign art_1672 = art_base | append: '-1672.webp' | asset_url
      -%}
      <img
        src="{{ art_1440 }}"
        srcset="{{ art_640 }} 640w, {{ art_1024 }} 1024w, {{ art_1440 }} 1440w, {{ art_1672 }} 1672w"
        sizes="100vw"
        width="1672"
        height="941"
        alt="{{ section.settings.artwork_alt | escape }}"
        class="seasonal-hero__image seasonal-hero__image--artwork"
        loading="{{ loading }}"
        fetchpriority="{{ priority }}"
      >
    {%- else -%}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg seasonal-hero__image' }}
    {%- endif -%}
  </div>

  <div class="seasonal-hero__overlay seasonal-hero__overlay--{{ section.settings.overlay_style }}" aria-hidden="true"></div>
  {% render 'seasonal-effect', effect: section.settings.effect %}

  <div class="page-width seasonal-hero__content">
    <div class="seasonal-hero__box">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank or section.settings.heading_accent != blank -%}
        <{{ heading_tag }} class="h0 seasonal-hero__heading">
          {{- section.settings.heading | escape -}}
          {%- if section.settings.heading_accent != blank -%}
            <span class="seasonal-hero__accent">{{ section.settings.heading_accent | escape }}</span>
          {%- endif -%}
        </{{ heading_tag }}>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="rte seasonal-hero__text">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label_1 != blank or section.settings.button_label_2 != blank -%}
        <div class="button-group">
          {%- if section.settings.button_label_1 != blank -%}
            <a
              {% if section.settings.button_link_1 != blank %}
                href="{{ section.settings.button_link_1 }}"
              {% else %}
                role="link" aria-disabled="true"
              {% endif %}
              class="button"
            >
              {{- section.settings.button_label_1 | escape -}}
            </a>
          {%- endif -%}
          {%- if section.settings.button_label_2 != blank -%}
            <a
              {% if section.settings.button_link_2 != blank %}
                href="{{ section.settings.button_link_2 }}"
              {% else %}
                role="link" aria-disabled="true"
              {% endif %}
              class="button button--secondary"
            >
              {{- section.settings.button_label_2 | escape -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:names.seasonal_hero",
  "class": "section-seasonal-hero",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:settings.headers.image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image",
      "info": "t:info.hero_image"
    },
    {
      "type": "select",
      "id": "artwork",
      "label": "t:settings.artwork",
      "info": "t:info.artwork",
      "options": [
        { "value": "none", "label": "t:options.none" },
        { "value": "halloween", "label": "t:options.season.halloween" },
        { "value": "noel", "label": "t:options.season.christmas" },
        { "value": "paques", "label": "t:options.season.easter" },
        { "value": "valentin", "label": "t:options.season.valentine" },
        { "value": "ete", "label": "t:options.season.summer" }
      ],
      "default": "none"
    },
    {
      "type": "text",
      "id": "artwork_alt",
      "label": "t:settings.artwork_alt",
      "info": "t:info.artwork_alt"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:settings.image_position",
      "info": "t:info.image_position",
      "options": [
        { "value": "center center", "label": "t:options.center" },
        { "value": "left center", "label": "t:options.left" },
        { "value": "right center", "label": "t:options.right" },
        { "value": "center top", "label": "t:options.top" },
        { "value": "center bottom", "label": "t:options.bottom" }
      ],
      "default": "center center"
    },
    {
      "type": "select",
      "id": "mobile_image_position",
      "label": "t:settings.mobile_image_position",
      "options": [
        { "value": "center center", "label": "t:options.center" },
        { "value": "25% center", "label": "t:options.left" },
        { "value": "75% center", "label": "t:options.right" }
      ],
      "default": "center center"
    },
    {
      "type": "checkbox",
      "id": "animate_image",
      "label": "t:settings.animate_image",
      "info": "t:info.reduced_motion",
      "default": true
    },
    {
      "type": "select",
      "id": "effect",
      "label": "t:settings.effect",
      "info": "t:info.reduced_motion",
      "options": [
        { "value": "none", "label": "t:options.none" },
        { "value": "embers", "label": "t:options.effect.embers" },
        { "value": "snow", "label": "t:options.effect.snow" },
        { "value": "petals", "label": "t:options.effect.petals" },
        { "value": "sparkles", "label": "t:options.effect.sparkles" }
      ],
      "default": "none"
    },
    {
      "type": "header",
      "content": "t:settings.headers.layout"
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:settings.height",
      "options": [
        { "value": "medium", "label": "t:options.medium" },
        { "value": "large", "label": "t:options.large" },
        { "value": "full", "label": "t:options.full_screen" }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "t:settings.content_position",
      "options": [
        { "value": "left", "label": "t:options.left" },
        { "value": "center", "label": "t:options.center" },
        { "value": "right", "label": "t:options.right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "t:settings.overlay_style",
      "options": [
        { "value": "left", "label": "t:options.overlay.left" },
        { "value": "right", "label": "t:options.overlay.right" },
        { "value": "bottom", "label": "t:options.overlay.bottom" },
        { "value": "full", "label": "t:options.overlay.full" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:settings.overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 70
    },
    {
      "type": "header",
      "content": "t:settings.headers.text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.eyebrow",
      "default": "New season"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Tell your seasonal story"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "t:settings.heading_accent",
      "default": "with a bold image."
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:settings.heading_tag",
      "info": "t:info.heading_tag",
      "options": [
        { "value": "h1", "label": "t:options.heading_tag.h1" },
        { "value": "h2", "label": "t:options.heading_tag.h2" }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:settings.text",
      "default": "<p>Use this banner to introduce your collection and set the mood of the season.</p>"
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "t:settings.button_label_1",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "t:settings.button_link_1"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "t:settings.button_label_2"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "t:settings.button_link_2"
    }
  ],
  "presets": [
    {
      "name": "t:names.seasonal_hero"
    }
  ]
}
{% endschema %}
