<div class="main-password color-{{ section.settings.color_scheme }}">
  <div class="main-password__inner">
    <div class="main-password__logo">
      {%- if settings.logo != blank -%}
        <h1 class="logo">{% render 'logo', eager: true %}</h1>
      {%- else -%}
        <h1 class="h1">{{ shop.name | escape }}</h1>
      {%- endif -%}
    </div>

    {%- if shop.password_message != blank -%}
      <div class="rte main-password__message">{{ shop.password_message }}</div>
    {%- endif -%}

    {%- if section.settings.show_newsletter -%}
      {%- assign newsletter_id = 'PasswordNewsletter-' | append: section.id -%}
      {%- form 'customer', id: newsletter_id, class: 'newsletter__form' -%}
        <input type="hidden" name="contact[tags]" value="prospect,password page">
        <h2 class="h3">{{ section.settings.newsletter_heading | escape }}</h2>
        <div class="newsletter__field">
          <label class="visually-hidden" for="PasswordNewsletterEmail-{{ section.id }}">{{ 'newsletter.label' | t }}</label>
          <input
            id="PasswordNewsletterEmail-{{ section.id }}"
            class="field__input"
            type="email"
            name="contact[email]"
            autocomplete="email"
            autocapitalize="off"
            spellcheck="false"
            required
            placeholder="{{ 'newsletter.placeholder' | t }}"
          >
          <button type="submit" class="button">{{ 'newsletter.button' | t }}</button>
        </div>
        {%- if form.errors -%}
          <p class="form-message form-message--error" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
        {%- elsif form.posted_successfully? -%}
          <p class="form-message form-message--success" role="status">{{ 'newsletter.success' | t }}</p>
        {%- endif -%}
      {%- endform -%}
    {%- endif -%}

    <details class="main-password__login">
      <summary class="link">{{ 'password.enter_using_password' | t }}</summary>
      {%- form 'storefront_password', class: 'main-password__form' -%}
        <div class="newsletter__field">
          <label class="visually-hidden" for="Password-{{ section.id }}">{{ 'password.label' | t }}</label>
          <input
            id="Password-{{ section.id }}"
            class="field__input"
            type="password"
            name="password"
            autocomplete="current-password"
            placeholder="{{ 'password.label' | t }}"
            {% if form.errors %}
              aria-invalid="true"
              aria-describedby="PasswordError-{{ section.id }}"
            {% endif %}
          >
          <button type="submit" class="button" name="commit">{{ 'password.enter' | t }}</button>
        </div>
        {%- if form.errors -%}
          <p class="form-message form-message--error" id="PasswordError-{{ section.id }}" role="alert">{{ 'password.error' | t }}</p>
        {%- endif -%}
      {%- endform -%}
      <p class="main-password__admin">{{ 'password.admin_link_html' | t }}</p>
    </details>

    <p class="main-password__powered">{{ 'password.powered_by_shopify_html' | t }}</p>
  </div>
</div>

{% schema %}
{
  "name": "t:names.password",
  "class": "section-main-password",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "t:settings.show_newsletter",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "t:settings.heading",
      "default": "Be the first to know when we open"
    }
  ]
}
{% endschema %}
