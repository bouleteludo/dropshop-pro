{%- liquid
  assign heading_tag = 'h2'
  if request.page_type == 'index' and section.index == 1
    assign heading_tag = 'h1'
  endif

  assign active_block = nil
  assign active_index = 0
  for block in section.blocks
    capture is_active
      render 'date-range-active', start_month: block.settings.start_month, start_day: block.settings.start_day, end_month: block.settings.end_month, end_day: block.settings.end_day
    endcapture
    if is_active contains 'true'
      assign active_block = block
      assign active_index = forloop.index
      break
    endif
  endfor

  if active_block
    assign active_id = 'season-' | append: active_index
  else
    assign active_id = 'default'
  endif

  assign eager = false
  if section.index == 1
    assign eager = true
  endif
-%}

<div
  class="seasonal-banner seasonal-banner--{{ section.settings.height }}"
  style="--overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}; --image-position: {{ section.settings.image_position }}; --image-position-mobile: {{ section.settings.mobile_image_position }};"
  data-seasonal-banner
  data-active-slide="{{ active_id }}"
>
  {%- if request.design_mode -%}
    {%- comment -%} In the theme editor, every season is rendered so it can be previewed by selecting its block. {%- endcomment -%}
    {%- liquid
      assign default_hidden = true
      if active_id == 'default'
        assign default_hidden = false
      endif
    -%}
    {% render 'seasonal-banner-slide',
      content: section.settings,
      layout: section.settings,
      slide_id: 'default',
      heading_tag: heading_tag,
      hidden: default_hidden,
      eager: eager
    %}
    {%- for block in section.blocks -%}
      {%- liquid
        assign block_hidden = true
        if forloop.index == active_index
          assign block_hidden = false
        endif
        assign slide_id = 'season-' | append: forloop.index
      -%}
      {% render 'seasonal-banner-slide',
        content: block.settings,
        layout: section.settings,
        slide_id: slide_id,
        heading_tag: heading_tag,
        hidden: block_hidden,
        eager: eager,
        attributes: block.shopify_attributes
      %}
    {%- endfor -%}
  {%- elsif active_block -%}
    {% render 'seasonal-banner-slide',
      content: active_block.settings,
      layout: section.settings,
      slide_id: active_id,
      heading_tag: heading_tag,
      eager: eager,
      attributes: active_block.shopify_attributes
    %}
  {%- else -%}
    {% render 'seasonal-banner-slide',
      content: section.settings,
      layout: section.settings,
      slide_id: 'default',
      heading_tag: heading_tag,
      eager: eager
    %}
  {%- endif -%}
</div>

