<article class="main-article section color-{{ section.settings.color_scheme }} section--padding-medium">
  <div class="page-width page-width--narrow">
    <header class="article__header">
      <p class="article__meta">
        {{- article.published_at | time_tag: format: 'date' -}}
        {%- if section.settings.show_author %} &middot; {{ article.author | escape }}{% endif -%}
      </p>
      <h1 class="h1 article__title">{{ article.title | escape }}</h1>
    </header>

    {%- if article.image -%}
      <div class="article__media">
        {{
          article.image
          | image_url: width: 1800
          | image_tag:
            widths: '375, 750, 1100, 1500, 1800',
            sizes: '(min-width: 990px) 860px, 100vw',
            loading: 'eager',
            fetchpriority: 'high',
            alt: article.image.alt,
            class: 'article__image'
        }}
      </div>
    {%- endif -%}

    <div class="rte article__content">{{ article.content }}</div>

    {%- if article.tags.size > 0 -%}
      <ul class="article__tags" role="list" aria-label="{{ 'blogs.tags_label' | t }}">
        {%- for tag in article.tags -%}
          <li><a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="pill">{{ tag | escape }}</a></li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <a href="{{ blog.url }}" class="link article__back">
      {% render 'icon', name: 'chevron-left' %}
      {{ 'blogs.back_to_blog' | t: title: blog.title }}
    </a>

    {%- if blog.comments_enabled? -%}
      <section class="comments" aria-labelledby="Comments-{{ section.id }}">
        <h2 class="h3" id="Comments-{{ section.id }}">{{ 'blogs.comments.title' | t: count: article.comments_count }}</h2>

        {%- paginate article.comments by 10 -%}
          {%- if article.comments.size > 0 -%}
            <ul class="comments__list" role="list">
              {%- for comment in article.comments -%}
                <li class="comment" id="{{ comment.id }}">
                  <div class="rte comment__content">{{ comment.content }}</div>
                  <p class="comment__meta">
                    <span class="comment__author">{{ comment.author | escape }}</span>
                    &middot; {{ comment.created_at | time_tag: format: 'date' }}
                  </p>
                </li>
              {%- endfor -%}
            </ul>
            {% render 'pagination', paginate: paginate, anchor: '#comments' %}
          {%- endif -%}
        {%- endpaginate -%}

        {%- form 'new_comment', article, class: 'comments__form', id: 'comments' -%}
          <h3 class="h4">{{ 'blogs.comments.form_title' | t }}</h3>
          {%- if form.posted_successfully? -%}
            <p class="form-message form-message--success" role="status" tabindex="-1" autofocus>
              {%- if blog.moderated? -%}
                {{ 'blogs.comments.success_moderated' | t }}
              {%- else -%}
                {{ 'blogs.comments.success' | t }}
              {%- endif -%}
            </p>
          {%- elsif form.errors -%}
            <div class="form-message form-message--error" role="alert" tabindex="-1" autofocus>
              <p>{{ 'blogs.comments.error' | t }}</p>
              <ul>
                {%- for field in form.errors -%}
                  <li>{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          <div class="contact__grid">
            <div class="field">
              <label class="field__label" for="CommentAuthor-{{ section.id }}">{{ 'blogs.comments.name' | t }} <span aria-hidden="true">*</span></label>
              <input
                class="field__input"
                type="text"
                id="CommentAuthor-{{ section.id }}"
                name="comment[author]"
                value="{{ form.author }}"
                autocomplete="name"
                required
                aria-required="true"
                {% if form.errors contains 'author' %}
                  aria-invalid="true"
                {% endif %}
              >
            </div>
            <div class="field">
              <label class="field__label" for="CommentEmail-{{ section.id }}">{{ 'blogs.comments.email' | t }} <span aria-hidden="true">*</span></label>
              <input
                class="field__input"
                type="email"
                id="CommentEmail-{{ section.id }}"
                name="comment[email]"
                value="{{ form.email }}"
                autocomplete="email"
                autocapitalize="off"
                spellcheck="false"
                required
                aria-required="true"
                {% if form.errors contains 'email' %}
                  aria-invalid="true"
                {% endif %}
              >
            </div>
          </div>
          <div class="field">
            <label class="field__label" for="CommentBody-{{ section.id }}">{{ 'blogs.comments.message' | t }} <span aria-hidden="true">*</span></label>
            <textarea
              class="field__input"
              rows="5"
              id="CommentBody-{{ section.id }}"
              name="comment[body]"
              required
              aria-required="true"
              {% if form.errors contains 'body' %}
                aria-invalid="true"
              {% endif %}
            >{{ form.body }}</textarea>
          </div>
          {%- if blog.moderated? -%}
            <p class="field__hint">{{ 'blogs.comments.moderated' | t }}</p>
          {%- endif -%}
          <button type="submit" class="button">{{ 'blogs.comments.post' | t }}</button>
        {%- endform -%}
      </section>
    {%- endif -%}
  </div>
</article>

{% schema %}
{
  "name": "t:names.blog_post",
  "class": "section-main-article",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "t:settings.show_author",
      "default": false
    }
  ]
}
{% endschema %}
