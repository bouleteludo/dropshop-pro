<cart-items class="main-cart section color-{{ section.settings.color_scheme }} section--padding-medium" data-section-id="{{ section.id }}">
  <div class="page-width" data-cart-part="content">
    <h1 class="h1 page-title">{{ 'cart.title' | t }}</h1>

    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" id="CartForm-{{ section.id }}" class="cart" novalidate>
        <table class="cart-table">
          <caption class="visually-hidden">{{ 'cart.title' | t }}</caption>
          <thead>
            <tr>
              <th scope="col" class="cart-table__heading">{{ 'cart.headings.product' | t }}</th>
              <th scope="col" class="cart-table__heading">{{ 'cart.headings.quantity' | t }}</th>
              <th scope="col" class="cart-table__heading cart-table__heading--total">{{ 'cart.headings.total' | t }}</th>
            </tr>
          </thead>
          <tbody>
            {%- for item in cart.items -%}
              <tr class="cart-item" id="CartItem-{{ item.index }}">
                <td class="cart-item__product">
                  <div class="cart-item__media">
                    {%- if item.image -%}
                      <a href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                        {{ item.image | image_url: width: 300 | image_tag: loading: 'lazy', width: 120, height: 120, alt: item.image.alt, class: 'cart-item__image' }}
                      </a>
                    {%- endif -%}
                  </div>
                  <div class="cart-item__details">
                    <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title | escape }}</a>

                    <div class="cart-item__unit">
                      {%- if item.original_price != item.final_price -%}
                        <span class="visually-hidden">{{ 'products.price.regular_price' | t }}</span>
                        <s>{{ item.original_price | money }}</s>
                        <span class="visually-hidden">{{ 'products.price.sale_price' | t }}</span>
                      {%- endif -%}
                      {{ item.final_price | money }}
                    </div>

                    {%- if item.unit_price_measurement -%}
                      <p class="cart-item__unit-price">
                        <span class="visually-hidden">{{ 'products.price.unit_price' | t }}</span>
                        {{ item.unit_price | money -}}
                        <span aria-hidden="true">/</span>
                        <span class="visually-hidden">&nbsp;{{ 'products.price.unit_price_separator' | t }}&nbsp;</span>
                        {%- if item.unit_price_measurement.reference_value != 1 -%}
                          {{- item.unit_price_measurement.reference_value -}}
                        {%- endif -%}
                        {{ item.unit_price_measurement.reference_unit }}
                      </p>
                    {%- endif -%}

                    {%- if item.product.has_only_default_variant == false or item.properties.size != 0 or item.selling_plan_allocation != nil -%}
                      <dl class="cart-item__options">
                        {%- unless item.product.has_only_default_variant -%}
                          {%- for option in item.options_with_values -%}
                            <div class="cart-item__option">
                              {%- assign dt_label = option.name | escape -%}
                              <dt>{{ 'general.label_with_colon' | t: label: dt_label }}</dt>
                              <dd>{{ option.value | escape }}</dd>
                            </div>
                          {%- endfor -%}
                        {%- endunless -%}

                        {%- for property in item.properties -%}
                          {%- assign property_first_char = property.first | slice: 0 -%}
                          {%- if property.last != blank and property_first_char != '_' -%}
                            <div class="cart-item__option">
                              {%- assign dt_label = property.first | escape -%}
                              <dt>{{ 'general.label_with_colon' | t: label: dt_label }}</dt>
                              <dd>
                                {%- if property.last contains '/uploads/' -%}
                                  <a href="{{ property.last }}" class="link" target="_blank" rel="noopener">{{ property.last | split: '/' | last }}</a>
                                {%- else -%}
                                  {{ property.last | escape }}
                                {%- endif -%}
                              </dd>
                            </div>
                          {%- endif -%}
                        {%- endfor -%}

                        {%- if item.selling_plan_allocation != nil -%}
                          <div class="cart-item__option">
                            {%- assign dt_label = 'cart.selling_plan' | t -%}
                            <dt>{{ 'general.label_with_colon' | t: label: dt_label }}</dt>
                            <dd>{{ item.selling_plan_allocation.selling_plan.name | escape }}</dd>
                          </div>
                        {%- endif -%}
                      </dl>
                    {%- endif -%}

                    {%- if item.line_level_discount_allocations.size > 0 -%}
                      <ul class="cart-item__discounts" role="list" aria-label="{{ 'cart.discounts' | t }}">
                        {%- for discount in item.line_level_discount_allocations -%}
                          <li class="discount-tag">
                            {% render 'icon', name: 'gift' %}
                            {{ discount.discount_application.title | escape }} (-{{ discount.amount | money }})
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  </div>
                </td>

                <td class="cart-item__quantity">
                  <label class="visually-hidden" for="Quantity-{{ item.index }}">
                    {{ 'products.quantity.input_label' | t: product: item.product.title }}
                  </label>
                  <quantity-input class="quantity">
                    <button type="button" class="quantity__button" name="minus">
                      {% render 'icon', name: 'minus' %}
                      <span class="visually-hidden">{{ 'products.quantity.decrease' | t: product: item.product.title }}</span>
                    </button>
                    <input
                      class="quantity__input"
                      id="Quantity-{{ item.index }}"
                      type="number"
                      name="updates[]"
                      value="{{ item.quantity }}"
                      min="0"
                      step="{{ item.variant.quantity_rule.increment | default: 1 }}"
                      {% if item.variant.quantity_rule.max != null %}
                        max="{{ item.variant.quantity_rule.max }}"
                      {% endif %}
                      inputmode="numeric"
                      data-line="{{ item.index }}"
                      data-cart-quantity
                    >
                    <button type="button" class="quantity__button" name="plus">
                      {% render 'icon', name: 'plus' %}
                      <span class="visually-hidden">{{ 'products.quantity.increase' | t: product: item.product.title }}</span>
                    </button>
                  </quantity-input>
                  <a href="{{ item.url_to_remove }}" class="link cart-item__remove" data-line="{{ item.index }}" data-cart-remove>
                    {{ 'cart.remove' | t }}<span class="visually-hidden"> {{ item.product.title | escape }}</span>
                  </a>
                </td>

                <td class="cart-item__total">
                  {%- if item.original_line_price != item.final_line_price -%}
                    <span class="visually-hidden">{{ 'products.price.regular_price' | t }}</span>
                    <s class="cart-item__compare">{{ item.original_line_price | money }}</s>
                    <span class="visually-hidden">{{ 'products.price.sale_price' | t }}</span>
                  {%- endif -%}
                  <span class="cart-item__line-price">{{ item.final_line_price | money }}</span>
                </td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>

        <div class="cart__footer">
          {%- if section.settings.show_note -%}
            <div class="field cart__note">
              <label class="field__label" for="CartNote-{{ section.id }}">{{ 'cart.note' | t }}</label>
              <textarea id="CartNote-{{ section.id }}" class="field__input" name="note" rows="3" data-cart-note>{{ cart.note }}</textarea>
            </div>
          {%- endif -%}

          <div class="cart__summary">
            {%- if cart.cart_level_discount_applications.size > 0 -%}
              <ul class="cart__discounts" role="list" aria-label="{{ 'cart.discounts' | t }}">
                {%- for discount in cart.cart_level_discount_applications -%}
                  <li class="discount-tag">
                    {% render 'icon', name: 'gift' %}
                    {{ discount.title | escape }} (-{{ discount.total_allocated_amount | money }})
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}

            <p class="cart__total">
              <span>{{ 'cart.total' | t }}</span>
              <span class="cart__total-value">{{ cart.total_price | money_with_currency }}</span>
            </p>

            <p class="cart__taxes">
              {%- if cart.taxes_included and shop.shipping_policy.body != blank -%}
                {{ 'cart.taxes_included_shipping_at_checkout_html' | t: link: shop.shipping_policy.url }}
              {%- elsif cart.taxes_included -%}
                {{ 'cart.taxes_included_shipping_at_checkout' | t }}
              {%- elsif shop.shipping_policy.body != blank -%}
                {{ 'cart.taxes_and_shipping_at_checkout_html' | t: link: shop.shipping_policy.url }}
              {%- else -%}
                {{ 'cart.taxes_and_shipping_at_checkout' | t }}
              {%- endif -%}
            </p>

            <div class="cart__buttons">
              <button type="submit" name="update" class="button button--secondary button--full cart__update">{{ 'cart.update' | t }}</button>
              <button type="submit" name="checkout" class="button button--full" form="CartForm-{{ section.id }}">{{ 'cart.checkout' | t }}</button>
            </div>

            {%- if additional_checkout_buttons -%}
              <div class="cart__dynamic-checkout">{{ content_for_additional_checkout_buttons }}</div>
            {%- endif -%}
          </div>
        </div>
      </form>
    {%- else -%}
      <div class="empty-state">
        <p class="h3">{{ 'cart.empty' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="button">{{ 'general.continue_shopping' | t }}</a>
        {%- if shop.customer_accounts_enabled and customer == null -%}
          <p class="empty-state__login">{{ 'cart.login_html' | t: link: routes.account_login_url }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</cart-items>

<script src="{{ 'cart.js' | asset_url }}" type="module" defer="defer"></script>

{% schema %}
{
  "name": "t:names.cart",
  "class": "section-main-cart",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_note",
      "label": "t:settings.show_cart_note",
      "default": true
    }
  ]
}
{% endschema %}
