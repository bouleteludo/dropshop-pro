# Copie ce fichier en .env (jamais commité) : cp .env.example .env
# Les pourcentages s'écrivent en % : 1.5 = 1,5 %.

# ============================ SÉCURITÉ ============================
# paper = vrais prix, ordres simulés. live = argent réel (NON implémenté en V1).
MODE=paper
# Interrupteur global. false = le bot observe et journalise mais ne passe
# AUCUN ordre, même simulé. Mets true pour activer le paper trading.
ENABLE_TRADING=false
# Réservé au trading réel (V3). Laisse vide.
LIVE_TRADING_CONFIRMATION=

# ============================ MARCHÉ ==============================
EXCHANGE=binance
SYMBOL=BTC/USDT
# 1m, 5m, 15m, 1h, 4h, 1d…
TIMEFRAME=1h

# ======================= CAPITAL ET COÛTS =========================
INITIAL_CAPITAL=10000
# Commission par ordre (Binance spot : 0.1)
FEE_PCT=0.1
# Glissement défavorable estimé à chaque exécution
SLIPPAGE_PCT=0.05
# Écart achat/vente complet (la moitié est payée à chaque ordre)
SPREAD_PCT=0.02

# ============================ RISQUE ==============================
# Perte maximale si le stop est touché, en % du capital
RISK_PER_TRADE_PCT=1
# Taille maximale d'une position, en % du capital
MAX_POSITION_PCT=25
STOP_LOSS_PCT=2
TAKE_PROFIT_PCT=4
MAX_OPEN_POSITIONS=1
# Au-delà : plus aucune nouvelle entrée jusqu'au lendemain (UTC)
MAX_DAILY_LOSS_PCT=3
# Baisse depuis le plus haut du capital. Au-delà : arrêt verrouillé (reset-halt)
MAX_DRAWDOWN_PCT=15
# Perte par rapport au capital initial. Au-delà : arrêt verrouillé (reset-halt)
MAX_TOTAL_LOSS_PCT=20
MAX_TRADES_PER_DAY=5
# Montant minimal d'un ordre (en devise de cotation, ex. USDT)
MIN_ORDER_VALUE=10
# Refus d'entrée si le prix actuel s'écarte de plus de X % de la dernière clôture
MAX_PRICE_DEVIATION_PCT=2
# Refus d'entrée si la dernière bougie a plus de N bougies de retard
MAX_DATA_STALENESS_BARS=2
# Alerte si un trade perd plus de X % du capital
LARGE_LOSS_ALERT_PCT=2

# =========================== STRATÉGIE ============================
STRATEGY=ema_cross_rsi
EMA_FAST=20
EMA_SLOW=50
RSI_PERIOD=14
RSI_OVERBOUGHT=70

# ======================== BOUCLE TEMPS RÉEL =======================
POLL_SECONDS=60
# Bougies chargées à chaque cycle (au moins 3 x EMA_SLOW)
HISTORY_LIMIT=500
# Arrêt automatique après N erreurs consécutives (API injoignable…)
MAX_CONSECUTIVE_ERRORS=5

# =========================== FICHIERS =============================
STATE_DIR=state
LOG_DIR=logs
LOG_LEVEL=INFO

# ==================== SECRETS (V3 uniquement) =====================
# Inutiles en V1 : les données publiques ne demandent pas de clé.
# Plus tard : clé en LECTURE + TRADING SPOT seulement, JAMAIS de retrait,
# et restreinte à ton adresse IP si la plateforme le permet.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
