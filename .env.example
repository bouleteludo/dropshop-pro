# Postgres connection string (e.g. from Vercel Storage / Neon / Supabase)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# CJdropshipping API v2 (https://developers.cjdropshipping.com/)
# Get your API key from the CJ platform: My CJ > API > Add API.
CJ_API_BASE_URL="https://developers.cjdropshipping.com/api2.0/v1"
CJ_API_KEY="CJUserNum@api@xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Password gating /admin (HTTP Basic Auth, see middleware.ts) — any username works
ADMIN_PASSWORD="change-me"

# Stripe (https://dashboard.stripe.com/apikeys) — secret key, server-side only
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Signing secret for the webhook endpoint (dashboard.stripe.com/webhooks), used
# to verify events sent to /api/webhooks/stripe are really from Stripe
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Owner notification by e-mail on each new paid order (optional, via Resend: https://resend.com)
# Both OWNER_NOTIFY_EMAIL and RESEND_API_KEY must be set, otherwise nothing is sent.
# The e-mail has the order number, items, total and a link to /admin/orders (no customer address).
OWNER_NOTIFY_EMAIL=""
RESEND_API_KEY=""
# Optional sender, e.g. "BOO SHOP <commandes@your-domain.fr>" (needs a domain verified in Resend).
# Default: Resend's test sender, which only delivers to the e-mail of your Resend account.
OWNER_NOTIFY_FROM=""

# Commercial settings
# CJ imports use supplier USD converted to EUR, then a fixed 40% markup.
# Shipping, taxes and payment fees are excluded from this calculation.
NEXT_PUBLIC_SITE_URL="https://your-domain.fr"
NEXT_PUBLIC_CONTACT_EMAIL="contact@your-domain.fr"
NEXT_PUBLIC_SHIPPING_PRICE_EUR="4.90"
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD_EUR="49"
NEXT_PUBLIC_DELIVERY_ESTIMATE="3 à 8 jours ouvrés"

# Legal identity — REQUIRED before public launch
LEGAL_COMPANY_NAME="À compléter"
LEGAL_COMPANY_FORM="À compléter"
LEGAL_ADDRESS="À compléter"
LEGAL_SIRET="À compléter"
LEGAL_VAT="À compléter si applicable"
LEGAL_HOST_NAME="À compléter"
LEGAL_HOST_ADDRESS="À compléter"

# eBay Product Research (server-side application OAuth)
EBAY_ENVIRONMENT="production"
EBAY_CLIENT_ID=""
EBAY_CLIENT_SECRET=""
EBAY_MARKETPLACE_ID="EBAY_FR"

# Google Merchant Center / optional Merchant API credentials
GOOGLE_MERCHANT_ACCOUNT_ID=""
GOOGLE_MERCHANT_API_ACCESS_TOKEN=""

# Optional Vercel Cron protection for automatic CJ synchronization
CRON_SECRET=""
EBAY_USER_ACCESS_TOKEN=""
EBAY_CATEGORY_ID=""
EBAY_MERCHANT_LOCATION_KEY=""
EBAY_PAYMENT_POLICY_ID=""
EBAY_FULFILLMENT_POLICY_ID=""
EBAY_RETURN_POLICY_ID=""
EBAY_LISTING_DURATION="GTC"
